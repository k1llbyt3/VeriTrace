# Copy this file to ".env" and fill in the real values.
# ".env" is git-ignored and must NEVER be committed.
#
# "environment variable" = a named value your program reads from outside the
# source code, so secrets stay out of the codebase.

# ============================================================
# 1. REVERSE IMAGE SEARCH  (Milestone 4)
# ============================================================
# Real Google Lens search via SerpApi. Get a key here:
#   https://serpapi.com/manage-api-key
SERPAPI_KEY=

# ============================================================
# 2. FACE MATCHING  (Milestones 3 and 7)
# ============================================================
# InsightFace model pack. buffalo_l = SCRFD detector + ArcFace r100 embeddings.
INSIGHTFACE_MODEL=buffalo_l

# Detector input resolution (bigger = slower but finds smaller faces).
DET_SIZE=640

# Cosine-similarity cutoff for accepting a candidate as "same face".
# THIS IS AN EMPIRICAL DEMO VALUE, NOT A SCIENTIFIC CONSTANT.
# For the buffalo_l ArcFace model, same-person pairs usually land in the
# 0.4-0.8 range, so 0.70 is very strict. Calibrate it yourself in Milestone 3.
FACE_SIMILARITY_THRESHOLD=0.40

# How many search candidates to download + face-match at most (cost control).
MAX_CANDIDATES=20

# ============================================================
# 3. BLOCKCHAIN  (Milestones 11 and 12)
# ============================================================
# "RPC URL" = the HTTP address your code talks to a blockchain node through.
# Local Hardhat node (default):     http://127.0.0.1:8545
# Sepolia public testnet: e.g.      https://sepolia.infura.io/v3/<project-id>
RPC_URL=http://127.0.0.1:8545

# "private key" = the secret that controls a wallet and signs transactions.
# Use a THROWAWAY test wallet only. Never a wallet holding real money.
# Leave blank for the local Hardhat node (its built-in test account is used).
PRIVATE_KEY=

# Address of the deployed ContentRegistry contract. Filled in after deployment.
CONTRACT_ADDRESS=

# "chain id" = numeric id of the network. 31337 = local Hardhat, 11155111 = Sepolia.
CHAIN_ID=31337
